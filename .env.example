# Copy this file to .env and insert your own Gemini API key.
# .env is ignored by Git and must never be committed.
GENAI_API_KEY=replace_with_your_gemini_api_key

# Optional MySQL settings. The defaults are localhost, database smart_hostel_db,
# and username root. Set MYSQL_PASSWORD to your local MySQL password.
# MYSQL_URL=jdbc:mysql://localhost:3306/smart_hostel_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=replace_with_your_local_mysql_password

# Optional: defaults to the current Gemini Flash model.
# GENAI_MODEL=gemini-3.5-flash-lite

# Optional: defaults to 8080
# PORT=8080
